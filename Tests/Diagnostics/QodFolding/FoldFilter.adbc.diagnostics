[
  {
    "Command": "SELECT current_database() AS Name"
  },
  {
    "Command": "SELECT schema_name AS Name FROM information_schema.schemata WHERE catalog_name = 'acme_tpch' AND schema_name <> 'information_schema'"
  },
  {
    "Command": "SELECT table_name AS Name, table_type FROM information_schema.tables WHERE table_catalog = 'acme_tpch' AND table_schema = 'tpch1'"
  },
  {
    "Command": "SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_catalog = 'acme_tpch' AND table_schema = 'tpch1' AND table_name = 'nation' ORDER BY ordinal_position"
  },
  {
    "Command": "select \"n_nationkey\", \"n_name\", \"n_regionkey\", \"n_comment\" from \"tpch1\".\"nation\" where \"n_regionkey\" = CAST(0 as INTEGER) and not \"n_regionkey\" is null order by \"n_name\""
  }
]